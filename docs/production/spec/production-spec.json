      "name": "Product + Platform Specification Baseline",
      "acceptanceCriteria": [
        {
          "id": "P1-AC1",
          "title": "v1 scope and exclusions are documented and approved",
          "verification": ["manual_review", "artifact_check"]
        },
        {
          "id": "P1-AC2",
          "title": "NFRs include security, latency, uptime, cost, and data retention",
          "verification": ["artifact_check"]
        }
      ]
    },
    {
      "id": "phase-2",
      "name": "Cloud Architecture Redesign",
      "acceptanceCriteria": [
        {
          "id": "P2-AC1",
          "title": "Architecture defines web, gateway, workers, queue, and storage boundaries",
          "verification": ["artifact_check", "manual_review"]
        },
        {
          "id": "P2-AC2",
          "title": "Environment contract is complete and reproducible across staging/prod",
          "verification": ["integration_test", "artifact_check"]
        }
      ]
    },
    {
      "id": "phase-3",
      "name": "BYOK as First-Class Capability",
      "acceptanceCriteria": [
        {
          "id": "P3-AC1",
          "title": "User keys are encrypted at rest and revocable",
          "verification": ["security_test", "integration_test"]
        },
        {
          "id": "P3-AC2",
          "title": "Per-request provider routing honors user-selected key scope",
          "verification": ["unit_test", "integration_test"]
        }
      ]
    },
    {
      "id": "phase-4",
