          "verification": ["resilience_test", "integration_test"]
        }
      ]
    },
    {
      "id": "phase-5",
      "name": "Security + Compliance Hardening",
      "acceptanceCriteria": [
        {
          "id": "P5-AC1",
          "title": "AuthN/AuthZ boundaries are enforced for all user actions",
          "verification": ["security_test", "integration_test"]
        },
        {
          "id": "P5-AC2",
          "title": "Threat model findings are tracked with no open critical issues",
          "verification": ["artifact_check", "manual_review"]
        }
      ]
    },
    {
      "id": "phase-6",
      "name": "Fully Testable Quality System",
      "acceptanceCriteria": [
        {
          "id": "P6-AC1",
          "title": "Unit, contract, e2e, resilience, and security suites are defined",
